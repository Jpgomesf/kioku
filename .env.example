# scripts/start.sh copies this template to .env on its first run and replaces
# the CHANGE_ME values with unique random credentials. Keep .env private and
# out of version control; it is read as data, never sourced as shell code.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://memory:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:15432/memory
QDRANT_URL=http://127.0.0.1:16333
QDRANT_COLLECTION=local_memory_v1
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY

# Any Ollama model or OpenAI-compatible endpoint. Changing the model later
# needs `kioku reindex`. qwen3-embedding:0.6b (EMBEDDING_DIM=1024) scored best
# on the bundled eval, especially for non-English notes; see docs/evaluation.md.
# 11435 is the Ollama container, which runs on the CPU. On a Mac, an Ollama
# installed natively (brew install ollama) uses the GPU: set
# EMBEDDING_URL=http://127.0.0.1:11434 and make start skips the container.
EMBEDDING_PROVIDER=ollama
EMBEDDING_URL=http://127.0.0.1:11435
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_API_KEY=

MEMORY_HALF_LIFE_DAYS=90
MEMORY_LEGACY_THRESHOLD=0.2
MEMORY_DEFAULT_DOMAIN=local
MEMORY_NOTES_ROOT="CHANGE_ME_NOTES_ROOT"

# Tools exposed over MCP: core (search, get, save), all, or a list such as
# core,memory_import.
MEMORY_TOOLS=core

# Access profile for a stdio server. Each MCP client launches its own process,
# so set these in a client's MCP config to give that client less, for example
# MEMORY_SCOPES=read,write and MEMORY_DOMAINS=personal-*,kioku. Domains are
# comma-separated globs, or anchored regexes written re:<expr>.
# MEMORY_PRINCIPAL=local
# MEMORY_SCOPES=read,write,admin
# MEMORY_DOMAINS=*

# Vaults and locks (see README). Without this file Kioku has no vaults and works
# as before. The default is ~/.config/kioku/vaults.toml.
# MEMORY_VAULTS_FILE=/abs/path/vaults.toml
#
# Do NOT set these two here. Values in this file override each client's own
# settings, so every client would claim the same model and folder. Set them in
# each client's MCP config env instead:
#   MEMORY_PROVIDER=local|anthropic|openai|moonshot|deepseek|google|other
#   KIOKU_SESSION_DIR=/abs/path/to/the/project   (default: the working directory)

# Tool-call trace (off unless MEMORY_TRACE_FILE is set). MEMORY_TRACE_CONTENT is
# full, redacted (free text replaced by its length), or hashed (salted SHA-256;
# set MEMORY_TRACE_SALT to compare hashes across runs).
# MEMORY_TRACE_FILE=/abs/path/trace.jsonl
# With vaults, /abs/path/trace-{vault}.jsonl gives each vault its own file.
# MEMORY_TRACE_CONTENT=full

# Logs go to stderr. RUST_LOG=kioku=info logs every tool call and search with
# its duration; MEMORY_LOG_FORMAT=json emits JSON lines.
# MEMORY_LOG_FORMAT=text
