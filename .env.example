# scripts/start.sh creates .env with unique random credentials on its first run.
# Keep .env private and out of version control. Do not source it as a shell script.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://memory:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:15432/memory
QDRANT_URL=http://127.0.0.1:16333
QDRANT_COLLECTION=local_memory_v1
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY
EMBEDDING_PROVIDER=ollama
EMBEDDING_URL=http://127.0.0.1:11435
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_API_KEY=
MEMORY_HALF_LIFE_DAYS=90
MEMORY_LEGACY_THRESHOLD=0.2
MEMORY_DEFAULT_DOMAIN=local
MEMORY_NOTES_ROOT="CHANGE_ME_NOTES_ROOT"
